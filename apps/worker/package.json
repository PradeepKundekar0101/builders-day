{
  "name": "@buildwise/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "fixture": "tsx src/fixture.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "agent:fixture": "node --env-file-if-exists=.env.local --import tsx src/agent-fixture.ts",
    "deploy:fixture": "node --env-file-if-exists=.env.local --import tsx src/deploy-fixture.ts",
    "start:local": "caffeinate -i node --env-file-if-exists=.env.local --import tsx src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@buildwise/build-engine": "workspace:*",
    "@buildwise/cost-guard": "workspace:*",
    "@buildwise/shared": "workspace:*",
    "@electric-sql/pglite": "^0.3.14",
    "@supabase/supabase-js": "^2.118.0",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}

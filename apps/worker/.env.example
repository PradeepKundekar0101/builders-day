# Load with your process manager or container, never commit real values.
PROVN_LIVE_BUILDS=false
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Claude Agent SDK writes the product code.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
PROVN_BUILD_MODEL=
# Hard provider-spend cap per build in USD (reserved in the cost guard; the agent stops at 80%).
PROVN_BUILD_MAX_USD=3
PROVN_BUILD_WORKDIR=/work
# Optional: deploy each finished build to its own Vercel project (bw-<build id>). Without a token, builds stop at the source ZIP.
VERCEL_TOKEN=
# Team that owns the generated projects: id (team_...) or slug (e.g. conch-s-team). Empty = personal account.
VERCEL_TEAM_ID=
# The PROVN web origin allowed to embed deployed apps in the build page.
PROVN_SITE_URL=https://getbuildwise.vercel.app

# Load with your process manager or container, never commit real values.
PROVN_LIVE_BUILDS=false
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Claude Agent SDK writes the product code.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
PROVN_BUILD_MODEL=
# Hard provider-spend cap per build in USD (reserved in the cost guard; the agent stops at 80%).
PROVN_BUILD_MAX_USD=3
PROVN_BUILD_WORKDIR=/work

# Web (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# "true" shows Continue with Google; set only once the Google provider is configured
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=

# Optional analytics. All three values are required; otherwise analytics is disabled.
# Project token is public ingestion configuration, NOT a personal API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_ALLOWED_HOSTS=getbuildwise.vercel.app

# Server only - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Supabase local auth (Google OAuth)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Prompt Studio live intake (server only, opt-in pilot)
PROMPT_STUDIO_LIVE_ENABLED=false
ANTHROPIC_API_KEY=
# Optional Claude model override; defaults to claude-opus-5-5.
PROMPT_STUDIO_MODEL=

# Exact HTTPS origins for isolated worker previews (comma-separated, no wildcards).
PROVN_BUILD_PREVIEW_ORIGINS=

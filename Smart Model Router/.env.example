# Provn Route (Smart Router) configuration. Copy to .env (local) or add in
# Vercel > Project > Settings > Environment Variables. Never commit real keys.
# Every key is optional: a provider without a key is shown as "not connected"
# and the router falls back to the next best connected model.

# --- Tier 1: Frontier labs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Tier 2: SLM library (Hugging Face Inference Providers, OpenAI-compatible) ---
HF_TOKEN=
# HF_BASE_URL=https://router.huggingface.co/v1

# Bring-your-own models, as a JSON array. apiKeyEnv names another env var that holds the key.
# BYO_MODELS=[{"id":"acme-llm","name":"Acme LLM","baseURL":"https://api.acme.ai/v1","model":"acme-7b","apiKeyEnv":"ACME_API_KEY","fit":{"grunt":7,"chat":6}}]

# --- Tier 3: Local LLMs (Ollama, OpenAI-compatible) ---
# Vercel cannot reach your localhost. Either expose Ollama through a tunnel
# (e.g. https://xxxx.ngrok.app/v1) or use the console's "Run local in my browser" switch.
OLLAMA_BASE_URL=
# OLLAMA_API_KEY=ollama

# --- Router behaviour ---
# heuristic (default, free, ~1 ms) or llm (asks Claude Haiku 5.5 to classify; falls back to heuristic)
ROUTER_CLASSIFIER=heuristic
# auto | quality | balanced | saver | local
ROUTER_DEFAULT_MODE=auto
# Optional shared secret. When set, API calls must send header  x-provn-key: <value>
ROUTER_API_SECRET=

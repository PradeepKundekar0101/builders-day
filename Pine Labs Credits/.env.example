# Copy to .env and fill in. Never commit .env.

# mock = no Pine Labs calls, a fake checkout page on this server (great for demos)
# uat  = Pine Labs sandbox (test cards/UPI, no real money)
# live = real money
PINELABS_MODE=uat

# From Pine Labs Online dashboard -> Settings -> API Keys (test mode keys for UAT)
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
# Only if Pine Labs gave you a single pre-issued key instead of a client id/secret pair.
PINELABS_API_KEY=

# Webhook signing secret from the dashboard (Settings -> Webhooks / secret key), base64 as shown there.
# Leave empty to skip webhooks and rely on status polling only.
PINELABS_WEBHOOK_SECRET=

# Optional overrides. UAT default is https://pluraluat.v2.pinepg.in
# For live, set the production base URL shown in your Pine Labs dashboard / onboarding email.
PINELABS_BASE_URL=

# Pricing: $1 = 100 credits, $1 minimum. Pine Labs charges in INR, so we convert at this rate.
CREDITS_PER_USD=100
MIN_TOPUP_USD=1
CHARGE_CURRENCY=INR
USD_TO_INR=88

# Where this app is reachable. Pine Labs redirects the payer here after paying.
# Use your tunnel URL (cloudflared / ngrok) if you want webhooks to reach your Mac.
PUBLIC_BASE_URL=http://localhost:4600
PORT=4600

# Optional: protect the console/API with a token (recommended when using a tunnel).
ADMIN_TOKEN=

# Payment link lifetime in hours
LINK_EXPIRY_HOURS=24

# AgenticOrg (Pine Labs hackathon agent platform). Leave the key empty to use a built-in demo agent.
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# Provn credits charged per completed agent run
AGENT_RUN_CREDITS=10

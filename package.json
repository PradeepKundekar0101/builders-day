{
  "name": "buildwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint . && pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --local | prettier --stdin-filepath generated.ts > packages/db/src/database.types.ts",
    "test:db": "pnpm -r --filter @buildwise/db --filter web test:db",
    "check:bundle": "pnpm --filter @buildwise/scripts check:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
